# Build output
# Anchored to the repo root only, so `go build ./cmd/no-mistakes` output cannot
# be staged while bin/no-mistakes and cmd/no-mistakes stay tracked.
/no-mistakes
bin/
tmp/
.tmp/

# Go
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Dependency directories
vendor/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Demo intermediate
demo_raw.gif

# Environment
.env
.env.local
.no-mistakes/evidence/

# Agent scratch HOME inside a run worktree
# The CI-repair agent reproduces a failing check locally by pointing HOME at a
# directory in the worktree, which fills it with Go module and OS caches. The
# repair commit stages with `git add -A`, so without this entry those caches are
# committed and pushed onto the pull request branch.
.ci-local-home/

# Worktree-local gh release used to pin the user-attachments upload contract.
.scratch-gh/
